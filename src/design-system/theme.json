{
  "brandName": "AdVantage",
  "version": "2025.1.0",
  "designPhilosophy": "AI-First Digital Marketing Platform",
  
  "colors": {
    "primary": {
      "50": "#f0f9ff",
      "100": "#e0f2fe", 
      "200": "#bae6fd",
      "300": "#7dd3fc",
      "400": "#38bdf8",
      "500": "#0ea5e9",
      "600": "#0284c7",
      "700": "#0369a1",
      "800": "#075985",
      "900": "#0c4a6e",
      "950": "#082f49"
    },
    "secondary": {
      "50": "#fdf4ff",
      "100": "#fae8ff",
      "200": "#f5d0fe",
      "300": "#f0abfc",
      "400": "#e879f9",
      "500": "#d946ef",
      "600": "#c026d3",
      "700": "#a21caf",
      "800": "#86198f",
      "900": "#701a75",
      "950": "#4a044e"
    },
    "accent": {
      "ai": "#6366f1",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#06b6d4"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a",
      "950": "#020617"
    },
    "glass": {
      "light": "rgba(255, 255, 255, 0.8)",
      "dark": "rgba(0, 0, 0, 0.8)",
      "accent": "rgba(99, 102, 241, 0.1)"
    }
  },

  "typography": {
    "fontFamily": {
      "primary": "SF Pro Display",
      "secondary": "Inter",
      "mono": "SF Mono"
    },
    "scale": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "5xl": 48,
      "6xl": 60
    },
    "weight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "heavy": 800
    }
  },

  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },

  "borderRadius": {
    "none": 0,
    "sm": 4,
    "base": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "full": 9999
  },

  "shadows": {
    "glow": {
      "sm": "0 0 5px rgba(99, 102, 241, 0.3)",
      "md": "0 0 10px rgba(99, 102, 241, 0.4)",
      "lg": "0 0 15px rgba(99, 102, 241, 0.5)",
      "xl": "0 0 25px rgba(99, 102, 241, 0.6)"
    },
    "depth": {
      "sm": "0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)",
      "md": "0 3px 6px rgba(0, 0, 0, 0.15), 0 2px 4px rgba(0, 0, 0, 0.12)",
      "lg": "0 10px 20px rgba(0, 0, 0, 0.15), 0 3px 6px rgba(0, 0, 0, 0.10)",
      "xl": "0 15px 25px rgba(0, 0, 0, 0.15), 0 5px 10px rgba(0, 0, 0, 0.05)"
    },
    "ai": {
      "pulse": "0 0 20px rgba(99, 102, 241, 0.4), 0 0 40px rgba(99, 102, 241, 0.2)",
      "active": "0 0 30px rgba(99, 102, 241, 0.6), 0 0 60px rgba(99, 102, 241, 0.3)"
    }
  },

  "animations": {
    "duration": {
      "fast": 150,
      "normal": 300,
      "slow": 500,
      "slower": 800
    },
    "easing": {
      "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "elastic": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    },
    "transforms": {
      "scale": {
        "95": "scale(0.95)",
        "100": "scale(1)",
        "105": "scale(1.05)",
        "110": "scale(1.1)"
      },
      "translate": {
        "up": "translateY(-2px)",
        "down": "translateY(2px)",
        "left": "translateX(-2px)",
        "right": "translateX(2px)"
      }
    }
  },

  "glass": {
    "backdrop": {
      "light": "rgba(255, 255, 255, 0.8)",
      "dark": "rgba(0, 0, 0, 0.8)",
      "accent": "rgba(99, 102, 241, 0.1)"
    },
    "blur": {
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24
    },
    "border": {
      "light": "rgba(255, 255, 255, 0.2)",
      "dark": "rgba(255, 255, 255, 0.1)"
    }
  },

  "components": {
    "button": {
      "primary": {
        "background": "linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)",
        "shadow": "0 4px 15px rgba(99, 102, 241, 0.4)",
        "hover": {
          "transform": "translateY(-2px)",
          "shadow": "0 6px 20px rgba(99, 102, 241, 0.6)"
        }
      },
      "glass": {
        "background": "rgba(255, 255, 255, 0.1)",
        "border": "rgba(255, 255, 255, 0.2)",
        "backdrop": "blur(16px)"
      },
      "ai": {
        "background": "linear-gradient(135deg, #6366f1 0%, #06b6d4 100%)",
        "glow": "0 0 20px rgba(99, 102, 241, 0.5)"
      }
    },
    "card": {
      "glass": {
        "background": "rgba(255, 255, 255, 0.08)",
        "border": "rgba(255, 255, 255, 0.16)",
        "backdrop": "blur(16px)",
        "shadow": "0 8px 32px rgba(0, 0, 0, 0.12)"
      },
      "ai": {
        "background": "linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%)",
        "border": "rgba(99, 102, 241, 0.2)",
        "glow": "0 0 20px rgba(99, 102, 241, 0.2)"
      }
    },
    "input": {
      "glass": {
        "background": "rgba(255, 255, 255, 0.1)",
        "border": "rgba(255, 255, 255, 0.2)",
        "focus": {
          "border": "rgba(99, 102, 241, 0.5)",
          "glow": "0 0 10px rgba(99, 102, 241, 0.3)"
        }
      }
    }
  },

  "aiElements": {
    "conversation": {
      "user": {
        "background": "linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)",
        "shadow": "0 2px 8px rgba(99, 102, 241, 0.3)"
      },
      "ai": {
        "background": "rgba(255, 255, 255, 0.08)",
        "border": "rgba(99, 102, 241, 0.2)",
        "glow": "0 0 15px rgba(99, 102, 241, 0.2)"
      },
      "typing": {
        "pulse": "0 0 10px rgba(99, 102, 241, 0.4)"
      }
    },
    "insights": {
      "background": "linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%)",
      "border": "rgba(34, 197, 94, 0.3)",
      "icon": "rgba(34, 197, 94, 0.8)"
    },
    "performance": {
      "good": "rgba(34, 197, 94, 0.2)",
      "warning": "rgba(245, 158, 11, 0.2)",
      "error": "rgba(239, 68, 68, 0.2)"
    }
  },

  "darkMode": {
    "background": {
      "primary": "#0f172a",
      "secondary": "#1e293b",
      "tertiary": "#334155"
    },
    "text": {
      "primary": "#f8fafc",
      "secondary": "#cbd5e1",
      "muted": "#64748b"
    }
  },

  "accessibility": {
    "minTouchTarget": 44,
    "focusRing": {
      "color": "#6366f1",
      "width": 2,
      "offset": 2
    },
    "highContrast": {
      "background": "#000000",
      "text": "#ffffff",
      "accent": "#00ff00"
    }
  }
} 