{
  "name": "advantage-app",
  "version": "1.0.0",
  "description": "AI-powered social commerce platform with intelligent campaign management",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test",
    "test:e2e:build": "detox build",
    "test:e2e:ios": "node e2e/run-tests.js --platform=ios",
    "test:e2e:android": "node e2e/run-tests.js --platform=android",
    "test:e2e:auth": "node e2e/run-tests.js --file=auth-flow.e2e.ts",
    "test:e2e:dashboard": "node e2e/run-tests.js --file=dashboard-navigation.e2e.ts",
    "test:e2e:campaign": "node e2e/run-tests.js --file=campaign-management.e2e.ts",
    "test:e2e:workflow": "node e2e/run-tests.js --file=complete-user-workflow.e2e.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "build": "npx expo export --platform web",
    "build:preview": "eas build --profile preview",
    "build:web": "expo export --platform web",
    "build:production": "cross-env NODE_ENV=production EXPO_NO_TYPESCRIPT_CHECK=1 expo export --platform web",
    "build:quick": "cross-env EXPO_NO_TYPESCRIPT_CHECK=1 expo export --platform web",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "submit": "eas submit"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@google/generative-ai": "^0.2.0",
    "@hookform/resolvers": "^3.3.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.1.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@stripe/stripe-js": "^7.6.1",
    "@stripe/stripe-react-native": "^0.45.0",
    "@supabase/supabase-js": "^2.52.0",
    "@tanstack/react-query": "^5.17.0",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~18.2.14",
    "ajv": "^8.17.1",
    "expo": "^53.0.20",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.7",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.4",
    "expo-status-bar": "~2.2.3",
    "nativewind": "^4.0.1",
    "openai": "^4.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.48.2",
    "react-native": "^0.79.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-responsive-dimensions": "^3.1.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-super-grid": "^5.0.0",
    "react-native-svg": "^15.12.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "stripe": "^18.3.0",
    "yup": "^1.4.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "axios": "^1.10.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-react-constant-elements": "^6.23.0",
    "babel-plugin-transform-react-inline-elements": "^6.22.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^10.0.0",
    "eslint": "^8.55.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.1.0",
    "setimmediate": "^1.0.5",
    "typescript": "^5.8.3"
  },
  "private": true
}
